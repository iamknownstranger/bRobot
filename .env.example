# Copy to .env (git-ignored) and fill in. All four are REQUIRED — the
# processes exit non-zero at startup if any is missing or malformed.

# Telegram bot token from @BotFather. Format: <digits>:<35 chars>.
TELEGRAM_BOT_TOKEN=

# Your personal Telegram numeric user id. Every update from any other id is
# silently dropped.
TELEGRAM_OWNER_ID=

# Ollama HTTP endpoint. No silent default — set it explicitly.
OLLAMA_HOST=http://localhost:11434

# Model tag used for extraction/scoring, e.g. gemma3:12b
OLLAMA_MODEL=gemma3:12b

# Optional: IMAP credentials for the dedicated freebie inbox fetcher.
# Required only if sources.yaml contains an `imap` source.
FREEBIE_IMAP_HOST=
FREEBIE_IMAP_USER=
FREEBIE_IMAP_PASSWORD=
